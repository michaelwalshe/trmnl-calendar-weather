{%- comment -%}
================================================================================
  WEEK + WEATHER  -  TRMNL private plugin, "Plugin Merge" strategy
  Rolling week time grid under a weather strip: now, tomorrow, and the next few
  hours as condition icons over a sunlight curve.

  Three sources, each resolved from a plugin_instance_select form field, with a
  hard-coded merge variable as fallback (edit the names to match the ones in the
  Merge Variables dropdown - they are <plugin_keyname>_<plugin_setting_id>):

    calendar_source  Google Calendar        events + display preferences
    weather_source   Weather                now, today, tomorrow
    hourly_source    Weather Glance recipe  next few hours: temperature, an
                     icon and a time per reading (optional - the strip drops
                     the hourly panel without it)

  Sized for an 800x600 panel at ~167 PPI (Kindle 4 in landscape). The layout is
  flex/grid and fills whatever it is given; only the text-density heuristics
  need the pixel height, which comes from screen_height below.
================================================================================
{%- endcomment -%}

{%- comment -%} ---------- resolve the three sources ----------
  TRMNL aliases whatever the installer picked in a plugin_instance_select field
  under that field's keyname, so the keyname IS the data. A native plugin exposes
  its snapshot flat (calendar_source.events); a private plugin or webhook source
  nests it (hourly_source.merge_variables.temperatures). Resolve whichever is
  present, the same way TRMNL's own recipes do.

  Never reference a plugin id here. The author's id means nothing on someone
  else's account - a fork would resolve the alias and render blank.
{%- endcomment -%}
{%- assign cal = calendar_source.merge_variables | default: calendar_source -%}
{%- assign wx = weather_source.merge_variables | default: weather_source -%}
{%- assign hourly = hourly_source.merge_variables | default: hourly_source -%}
{%- if hourly.data -%}{%- assign hourly = hourly.data -%}{%- endif -%}

{%- comment -%} ---------- settings (custom fields, all optional) ---------- {%- endcomment -%}
{%- assign day_count = 7 -%}
{%- if days and days != "" -%}{%- assign day_count = days | plus: 0 -%}{%- endif -%}
{%- if day_count < 1 -%}{%- assign day_count = 1 -%}{%- endif -%}
{%- if day_count > 7 -%}{%- assign day_count = 7 -%}{%- endif -%}

{%- assign cfg_from = -1 -%}
{%- if hour_from and hour_from != "" -%}{%- assign cfg_from = hour_from | plus: 0 -%}{%- endif -%}
{%- assign cfg_to = -1 -%}
{%- if hour_to and hour_to != "" -%}{%- assign cfg_to = hour_to | plus: 0 -%}{%- endif -%}

{%- assign show_now = true -%}
{%- if now_line == "no" -%}{%- assign show_now = false -%}{%- endif -%}

{%- comment -%} ---------- panel size ----------
  Only used to decide how much text fits in a block; the layout is flex and
  fills the real screen regardless. trmnl.device wins when the platform sets it.
{%- endcomment -%}
{%- assign screen_w = 800 -%}
{%- assign screen_h = 600 -%}
{%- if screen_height and screen_height != "" -%}{%- assign screen_h = screen_height | plus: 0 -%}{%- endif -%}
{%- if trmnl.device.width -%}{%- assign screen_w = trmnl.device.width | plus: 0 -%}{%- endif -%}
{%- if trmnl.device.height -%}{%- assign screen_h = trmnl.device.height | plus: 0 -%}{%- endif -%}
{%- if screen_w < 320 -%}{%- assign screen_w = 800 -%}{%- endif -%}
{%- if screen_h < 240 -%}{%- assign screen_h = 600 -%}{%- endif -%}

{%- comment -%} preferences that come from the calendar plugin itself {%- endcomment -%}
{%- assign shade_weekends = true -%}
{%- if cal.shade_weekends == false -%}{%- assign shade_weekends = false -%}{%- endif -%}
{%- assign colorize = true -%}
{%- if cal.colorize_events == false -%}{%- assign colorize = false -%}{%- endif -%}
{%- assign highlight_today = true -%}
{%- if cal.highlight_today == false -%}{%- assign highlight_today = false -%}{%- endif -%}

{%- assign events = cal.events | sort: "start_full" -%}

{%- comment -%} ---------- clock ----------
  One definition of "today", taken from the clock. today_in_tz is read only for
  the UTC offset it carries, because trmnl.user.utc_offset reads 0 on accounts
  with no time zone set. Driving the columns, the today highlight, the now-line
  and the in-progress state from a single value stops them disagreeing when
  calendar data is cached across midnight.
{%- endcomment -%}
{%- assign tz_off = 0 -%}
{%- if trmnl.user.utc_offset -%}{%- assign tz_off = trmnl.user.utc_offset | plus: 0 -%}{%- endif -%}
{%- if cal.today_in_tz -%}
  {%- assign z = cal.today_in_tz | date: "%z" -%}
  {%- if z and z != "" -%}
    {%- assign z_h = z | slice: 1, 2 | plus: 0 -%}
    {%- assign z_m = z | slice: 3, 2 | plus: 0 -%}
    {%- assign z_s = z_h | times: 3600 -%}
    {%- assign z_s = z_m | times: 60 | plus: z_s -%}
    {%- if z contains "-" -%}{%- assign z_s = 0 | minus: z_s -%}{%- endif -%}
    {%- assign tz_off = z_s -%}
  {%- endif -%}
{%- endif -%}

{%- assign now_utc = "now" | date: "%s" | plus: 0 -%}
{%- if trmnl.system.timestamp_utc -%}{%- assign now_utc = trmnl.system.timestamp_utc | plus: 0 -%}{%- endif -%}
{%- assign now_local = now_utc | plus: tz_off -%}
{%- assign today = now_local | date: "%Y-%m-%d" -%}
{%- assign now_h = now_local | date: "%H" | plus: 0 -%}
{%- assign now_m = now_local | date: "%M" | plus: 0 -%}
{%- assign now_min = now_h | times: 60 | plus: now_m -%}

{%- comment -%} ---------- first column (noon anchors avoid DST drift) ---------- {%- endcomment -%}
{%- assign base_noon = today | date: "%s" | plus: 43200 -%}
{%- if week_start == "week" -%}
  {%- assign first_day = 1 -%}
  {%- if cal.first_day -%}{%- assign first_day = cal.first_day | plus: 0 -%}{%- endif -%}
  {%- assign dow = base_noon | date: "%w" | plus: 0 -%}
  {%- assign shift = dow | minus: first_day -%}
  {%- if shift < 0 -%}{%- assign shift = shift | plus: 7 -%}{%- endif -%}
  {%- assign shift_s = shift | times: 86400 -%}
  {%- assign base_noon = base_noon | minus: shift_s -%}
{%- endif -%}

{%- comment -%} ---------- which grid column is today? the weather strip lines up with it ---------- {%- endcomment -%}
{%- assign today_idx = 0 -%}
{%- for n in (1..day_count) -%}
  {%- assign off = n | minus: 1 | times: 86400 -%}
  {%- assign dk = base_noon | plus: off | date: "%Y-%m-%d" -%}
  {%- if dk == today -%}{%- assign today_idx = n -%}{%- endif -%}
{%- endfor -%}
{%- if today_idx < 1 -%}{%- assign today_idx = 1 -%}{%- endif -%}
{%- assign last_col = day_count | plus: 1 -%}
{%- assign c_now = today_idx | plus: 1 -%}
{%- assign c_tmrw = c_now | plus: 1 -%}
{%- assign c_graph = c_tmrw | plus: 1 -%}

{%- comment -%} ---------- one grey tone per calendar colour ---------- {%- endcomment -%}
{%- assign palette = "" -%}
{%- if colorize -%}
  {%- for e in events -%}
    {%- if e.background_color and e.background_color != "" -%}
      {%- unless palette contains e.background_color -%}
        {%- assign palette = palette | append: e.background_color | append: "," -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign palette = palette | split: "," | sort -%}

{%- comment -%} ---------- all-day band height ---------- {%- endcomment -%}
{%- assign ad_max = 0 -%}
{%- for n in (1..day_count) -%}
  {%- assign off = n | minus: 1 | times: 86400 -%}
  {%- assign day_noon = base_noon | plus: off -%}
  {%- assign ad_n = 0 -%}
  {%- for e in events -%}
    {%- if e.all_day -%}
      {%- assign s_ep = e.start_full | date: "%Y-%m-%d" | date: "%s" | plus: 0 -%}
      {%- assign x_ep = e.end_full | date: "%Y-%m-%d" | date: "%s" | plus: 0 -%}
      {%- if x_ep <= s_ep -%}{%- assign x_ep = s_ep | plus: 86400 -%}{%- endif -%}
      {%- if day_noon > s_ep and day_noon < x_ep -%}{%- assign ad_n = ad_n | plus: 1 -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if ad_n > ad_max -%}{%- assign ad_max = ad_n -%}{%- endif -%}
{%- endfor -%}
{%- assign ad_rows = ad_max -%}
{%- if ad_rows > 2 -%}{%- assign ad_rows = 2 -%}{%- endif -%}
{%- assign ad_px = 0 -%}
{%- if ad_rows > 0 -%}{%- assign ad_px = ad_rows | times: 20 | plus: 3 -%}{%- endif -%}

{%- comment -%} ---------- hourly series ----------
  The recipe hands over one temperature, one pre-formatted label ("8 PM" or
  "20:00") and one icon URL per reading. Parse the hour out of each label once:
  it marks the current reading and sets the x axis of the sunlight curve.
{%- endcomment -%}
{%- assign temps = hourly.temperatures -%}
{%- assign n_pts = temps | size -%}
{%- assign last_pt = n_pts | minus: 1 -%}

{%- assign ts_mins = "" -%}
{%- for ts in hourly.timestamps_formatted -%}
  {%- assign tsu = ts | upcase -%}
  {%- assign th = tsu | split: ":" | first | split: " " | first | plus: 0 -%}
  {%- if tsu contains "PM" and th < 12 -%}{%- assign th = th | plus: 12 -%}{%- endif -%}
  {%- if tsu contains "AM" and th == 12 -%}{%- assign th = 0 -%}{%- endif -%}
  {%- assign tm = th | times: 60 -%}
  {%- assign ts_mins = ts_mins | append: tm | append: "," -%}
{%- endfor -%}
{%- assign ts_mins = ts_mins | split: "," -%}
{%- assign n_ts = ts_mins | size -%}

{%- comment -%} which reading is the nearest hour? {%- endcomment -%}
{%- assign near_i = -1 -%}
{%- assign near_d = 99 -%}
{%- for tm in ts_mins -%}
  {%- assign th = tm | plus: 0 | divided_by: 60 -%}
  {%- assign d = th | minus: now_h -%}
  {%- if d < 0 -%}{%- assign d = 0 | minus: d -%}{%- endif -%}
  {%- if d > 12 -%}{%- assign d = 24 | minus: d -%}{%- endif -%}
  {%- if d < near_d -%}{%- assign near_d = d -%}{%- assign near_i = forloop.index0 -%}{%- endif -%}
{%- endfor -%}

{%- comment -%} ---------- daylight, which is what the curve plots ----------
  Parsed from the weather source; falls back to 06:00/19:00 when absent.
{%- endcomment -%}
{%- assign sun_up = 360 -%}
{%- assign sun_dn = 1140 -%}
{%- assign sr_txt = wx.forecast.right_now.sunrise -%}
{%- if sr_txt and sr_txt != "" and sr_txt contains ":" -%}
  {%- assign sr_p = sr_txt | split: ":" -%}
  {%- assign sr_h = sr_p[0] | plus: 0 -%}
  {%- assign sr_m = sr_p[1] | plus: 0 -%}
  {%- assign sun_up = sr_h | times: 60 | plus: sr_m -%}
{%- endif -%}
{%- assign ss_txt = wx.forecast.right_now.sunset -%}
{%- if ss_txt and ss_txt != "" and ss_txt contains ":" -%}
  {%- assign ss_p = ss_txt | split: ":" -%}
  {%- assign ss_h = ss_p[0] | plus: 0 -%}
  {%- assign ss_m = ss_p[1] | plus: 0 -%}
  {%- assign sun_dn = ss_h | times: 60 | plus: ss_m -%}
{%- endif -%}

{%- comment -%} without the hourly panel the strip shrinks and the grid takes the space {%- endcomment -%}
{%- assign has_hourly = false -%}
{%- if temps and temps != empty and c_graph <= last_col -%}{%- assign has_hourly = true -%}{%- endif -%}
{%- assign sun_px = 46 -%}
{%- assign wx_h = 58 -%}
{%- if has_hourly -%}{%- assign wx_h = 88 -%}{%- endif -%}

{%- comment -%} ---------- the sunlight curve ----------
  Two stacked divs under a clip-path polygon rather than an <svg>. The points are
  percentages, so the shape stretches to whatever width the columns end up
  without the template having to know it; an <svg> would need
  preserveAspectRatio="none" to do the same, and that scales the stroke
  unevenly with it.

  Solar elevation is approximated by an inverted parabola: zero at sunrise and
  sunset, peaking at solar noon. Close enough at 46 pixels tall, and it needs
  only multiply and divide - Liquid has no sin.

  x runs 0..100 across the panel with the readings on column centres, so the
  curve carries on half a step past the first and last of them rather than
  stopping short of the edges. One pass builds two point strings: the shape, and
  the same shape pushed down by the line width. The lower one is painted in paper
  on top, so all that survives of the ink layer is the curve's edge - a line,
  with nothing shaded underneath it.

  y=0 sits at sun_base, not at 100, so a night hour still shows the baseline.
{%- endcomment -%}
{%- assign sun_top = 10 -%}
{%- assign sun_base = 95 -%}
{%- assign sun_amp = sun_base | minus: sun_top -%}
{%- assign lw_pct = 200.0 | divided_by: sun_px -%}

{%- comment -%} The readings are evenly spaced, so take the step from the first
  two and multiply, rather than subtracting the last label from the first: over a
  window that wraps midnight the endpoints alone cannot say whether the span is
  four hours or twenty-eight. It also rejects a daily-interval recipe for free,
  which emits dates rather than times - every label parses to hour zero, so the
  step is nil and the implied window overruns a day. {%- endcomment -%}
{%- assign m_first = 0 -%}
{%- assign win_min = 0 -%}
{%- assign step_min = 0 -%}
{%- assign has_sun = false -%}
{%- if has_hourly and n_pts > 1 and n_ts >= n_pts and sun_dn > sun_up -%}
  {%- assign m_first = ts_mins[0] | plus: 0 -%}
  {%- assign m_next = ts_mins[1] | plus: 0 -%}
  {%- assign step_min = m_next | minus: m_first -%}
  {%- if step_min <= 0 -%}{%- assign step_min = step_min | plus: 1440 -%}{%- endif -%}
  {%- assign win_min = step_min | times: last_pt -%}
  {%- if step_min > 0 and win_min <= 1440 -%}{%- assign has_sun = true -%}{%- endif -%}
{%- endif -%}

{%- assign sun_shape = "" -%}
{%- assign sun_under = "" -%}
{%- if has_sun -%}
  {%- assign half_step = step_min | times: 0.5 -%}
  {%- assign m_lo = m_first | minus: half_step -%}
  {%- assign chart_min = win_min | plus: half_step | plus: half_step -%}
  {%- assign sun_mid = sun_up | plus: sun_dn | divided_by: 2 -%}
  {%- assign sun_half = sun_dn | minus: sun_up | divided_by: 2 -%}
  {%- assign n_samp = last_pt | times: 4 -%}
  {%- for s in (0..n_samp) -%}
    {%- assign fx = s | times: 1.0 | divided_by: n_samp -%}
    {%- assign m = fx | times: chart_min | plus: m_lo -%}
    {%- comment -%} the window can start before midnight and end after the next
      one, so fold back into a single day - twice at the outside {%- endcomment -%}
    {%- if m < 0 -%}{%- assign m = m | plus: 1440 -%}{%- endif -%}
    {%- if m >= 1440 -%}{%- assign m = m | minus: 1440 -%}{%- endif -%}
    {%- if m >= 1440 -%}{%- assign m = m | minus: 1440 -%}{%- endif -%}
    {%- assign y = sun_base -%}
    {%- if m > sun_up and m < sun_dn -%}
      {%- assign d = m | minus: sun_mid | times: 1.0 | divided_by: sun_half -%}
      {%- assign e = d | times: d -%}
      {%- assign e = 1.0 | minus: e -%}
      {%- assign drop = e | times: sun_amp -%}
      {%- assign y = sun_base | minus: drop -%}
    {%- endif -%}
    {%- assign xs = fx | times: 100 | round: 2 -%}
    {%- assign ys = y | round: 2 -%}
    {%- assign yu = y | plus: lw_pct | round: 2 -%}
    {%- assign sun_shape = sun_shape | append: xs | append: "% " | append: ys | append: "%," -%}
    {%- assign sun_under = sun_under | append: xs | append: "% " | append: yu | append: "%," -%}
  {%- endfor -%}
  {%- assign sun_shape = sun_shape | append: "100% 100%,0% 100%" -%}
  {%- assign sun_under = sun_under | append: "100% 100%,0% 100%" -%}
{%- endif -%}

{%- comment -%} ---------- fixed chrome, then whatever is left is the grid ---------- {%- endcomment -%}
{%- assign is_24h = true -%}
{%- if cal.time_format == "am/pm" -%}{%- assign is_24h = false -%}{%- endif -%}
{%- comment -%} the gutter only has to hold its widest label: "23" or "12 PM" {%- endcomment -%}
{%- assign gut = 66 -%}
{%- if is_24h -%}{%- assign gut = 44 -%}{%- endif -%}
{%- assign head_h = 30 -%}
{%- assign body_px = screen_h | minus: wx_h | minus: head_h | minus: ad_px | minus: 4 -%}
{%- if body_px < 120 -%}{%- assign body_px = 120 -%}{%- endif -%}

{%- comment -%} ---------- vertical window: which hours to show ---------- {%- endcomment -%}
{%- assign auto_from = 99 -%}
{%- assign auto_to = -1 -%}
{%- for e in events -%}
  {%- unless e.all_day -%}
    {%- assign sh = e.start_full | date: "%H" | plus: 0 -%}
    {%- if sh < auto_from -%}{%- assign auto_from = sh -%}{%- endif -%}
    {%- assign eh = e.end_full | date: "%H" | plus: 0 -%}
    {%- assign em = e.end_full | date: "%M" | plus: 0 -%}
    {%- if em > 0 -%}{%- assign eh = eh | plus: 1 -%}{%- endif -%}
    {%- assign sd = e.start_full | date: "%Y-%m-%d" -%}
    {%- assign ed = e.end_full | date: "%Y-%m-%d" -%}
    {%- if sd != ed -%}{%- assign eh = 24 -%}{%- endif -%}
    {%- if eh > auto_to -%}{%- assign auto_to = eh -%}{%- endif -%}
  {%- endunless -%}
{%- endfor -%}

{%- assign h_from = -1 -%}
{%- assign auto_win = false -%}
{%- if cfg_from >= 0 -%}
  {%- assign h_from = cfg_from -%}
{%- elsif cal.scroll_time and cal.scroll_time != "" -%}
  {%- assign h_from = cal.scroll_time | split: ":" | first | plus: 0 -%}
{%- elsif auto_from < 99 -%}
  {%- assign h_from = auto_from -%}{%- assign auto_win = true -%}
{%- else -%}
  {%- assign h_from = 8 -%}{%- assign auto_win = true -%}
{%- endif -%}

{%- assign h_to = -1 -%}
{%- if cfg_to > 0 -%}
  {%- assign h_to = cfg_to -%}
{%- elsif cal.scroll_time_end and cal.scroll_time_end != "" -%}
  {%- assign se = cal.scroll_time_end | split: ":" -%}
  {%- assign h_to = se[0] | plus: 0 -%}
  {%- assign se_m = se[1] | plus: 0 -%}
  {%- if se_m > 0 -%}{%- assign h_to = h_to | plus: 1 -%}{%- endif -%}
{%- elsif auto_to > 0 -%}
  {%- assign h_to = auto_to -%}
{%- else -%}
  {%- assign h_to = 18 -%}
  {%- assign auto_win = true -%}
{%- endif -%}

{%- if h_from < 0 -%}{%- assign h_from = 0 -%}{%- endif -%}
{%- if h_from > 18 -%}{%- assign h_from = 18 -%}{%- endif -%}
{%- if h_to > 24 -%}{%- assign h_to = 24 -%}{%- endif -%}
{%- if h_to <= h_from -%}{%- assign h_to = h_from | plus: 8 -%}{%- endif -%}
{%- assign hours = h_to | minus: h_from -%}
{%- if hours < 6 -%}
  {%- assign h_to = h_from | plus: 6 -%}
  {%- if h_to > 24 -%}{%- assign h_to = 24 -%}{%- assign h_from = 18 -%}{%- endif -%}
  {%- assign hours = h_to | minus: h_from -%}
{%- endif -%}

{%- comment -%} ---------- cap the window so a row can still hold a label ----------
  Rows below ~30px cannot carry a 16px hour label and a readable block, so one
  06:00 or 23:00 outlier must not be allowed to crush the working day. When the
  span is too long, keep the max_hours window holding the most events; anything
  left outside is counted into the per-column edge badges.
{%- endcomment -%}
{%- assign max_hours = body_px | divided_by: 30 -%}
{%- if max_hours > 14 -%}{%- assign max_hours = 14 -%}{%- endif -%}
{%- if max_hours < 6 -%}{%- assign max_hours = 6 -%}{%- endif -%}
{%- if hours > max_hours -%}
  {%- assign best_from = h_from -%}
  {%- assign best_n = -1 -%}
  {%- assign latest_from = h_to | minus: max_hours -%}
  {%- for cand in (0..23) -%}
    {%- if cand >= h_from and cand <= latest_from -%}
      {%- assign cand_end = cand | plus: max_hours -%}
      {%- assign cand_n = 0 -%}
      {%- for e in events -%}
        {%- unless e.all_day -%}
          {%- assign esh = e.start_full | date: "%H" | plus: 0 -%}
          {%- if esh >= cand and esh < cand_end -%}{%- assign cand_n = cand_n | plus: 1 -%}{%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- if cand_n > best_n -%}{%- assign best_n = cand_n -%}{%- assign best_from = cand -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign h_from = best_from -%}
  {%- assign h_to = h_from | plus: max_hours -%}
  {%- assign hours = max_hours -%}
{%- endif -%}

{%- comment -%} ---------- drop empty hours off the tail ----------
  Only when the window was inferred: an explicit scroll_time or First/Last hour
  is a request, not a guess. Without this, one event running past midnight keeps
  the whole evening on screen and squeezes the hours that have anything in them.
{%- endcomment -%}
{%- if auto_win -%}
  {%- assign tail = h_from -%}
  {%- for e in events -%}
    {%- unless e.all_day -%}
      {%- assign esh = e.start_full | date: "%H" | plus: 0 -%}
      {%- if esh >= h_from and esh < h_to -%}
        {%- assign eeh = e.end_full | date: "%H" | plus: 0 -%}
        {%- assign eem = e.end_full | date: "%M" | plus: 0 -%}
        {%- if eem > 0 -%}{%- assign eeh = eeh | plus: 1 -%}{%- endif -%}
        {%- assign esd = e.start_full | date: "%Y-%m-%d" -%}
        {%- assign eed = e.end_full | date: "%Y-%m-%d" -%}
        {%- if esd != eed -%}{%- assign eeh = h_to -%}{%- endif -%}
        {%- if eeh > tail -%}{%- assign tail = eeh -%}{%- endif -%}
      {%- endif -%}
    {%- endunless -%}
  {%- endfor -%}
  {%- assign floor_to = h_from | plus: 6 -%}
  {%- if tail < floor_to -%}{%- assign tail = floor_to -%}{%- endif -%}
  {%- if tail < h_to -%}
    {%- assign h_to = tail -%}
    {%- assign hours = h_to | minus: h_from -%}
  {%- endif -%}
{%- endif -%}
{%- assign win_start = h_from | times: 60 -%}
{%- assign win_end = h_to | times: 60 -%}
{%- assign win_span = win_end | minus: win_start -%}

{%- comment -%} ---------- block metrics: how much text fits ---------- {%- endcomment -%}
{%- assign px_per_min = body_px | times: 1.0 | divided_by: win_span -%}
{%- assign col_w = screen_w | minus: gut | divided_by: day_count -%}

{%- comment -%} ---------- weather, normalised across providers ---------- {%- endcomment -%}
{%- assign wx_now = wx.forecast.right_now -%}
{%- assign wx_temp = wx.temperature -%}
{%- unless wx_temp -%}{%- assign wx_temp = wx_now.temperature -%}{%- endunless -%}
{%- assign wx_cond = wx.conditions -%}
{%- unless wx_cond -%}{%- assign wx_cond = wx.right_now_conditions -%}{%- endunless -%}
{%- unless wx_cond -%}{%- assign wx_cond = wx_now.conditions -%}{%- endunless -%}

{%- comment -%} the hourly source owns the temperatures; the weather plugin owns the rest {%- endcomment -%}
{%- assign temp_now = hourly.current_temp -%}
{%- unless temp_now -%}{%- assign temp_now = wx_temp -%}{%- endunless -%}

{%- comment -%} ---------- weather icons ----------
  Providers disagree: TRMNL emits bare "wi-*" names, Tempest serves absolute
  URLs to full-colour SVGs, OpenWeather uses codes like "01d". Colour art is
  close to invisible once the panel quantises to four greys, so every value is
  reduced to a slug and mapped onto TRMNL's mono wi-* set. Two icons share one
  pass because Liquid has no functions.
{%- endcomment -%}
{%- assign raw_now = wx.weather_image -%}
{%- unless raw_now and raw_now != "" -%}{%- assign raw_now = "none" -%}{%- endunless -%}
{%- assign raw_tmrw = wx.tomorrow_weather_image -%}
{%- unless raw_tmrw and raw_tmrw != "" -%}{%- assign raw_tmrw = "none" -%}{%- endunless -%}
{%- assign raw_list = raw_now | append: "|" | append: raw_tmrw | split: "|" -%}

{%- assign mapped = "" -%}
{%- for raw in raw_list -%}
  {%- assign slug = raw | split: "/" | last | split: "." | first | downcase -%}
  {%- assign name = "" -%}

  {%- comment -%} already one of ours {%- endcomment -%}
  {%- if slug contains "wi-" -%}
    {%- assign name = slug -%}
  {%- else -%}
    {%- comment -%} day or night? OpenWeather marks night with a trailing "n" {%- endcomment -%}
    {%- assign night = false -%}
    {%- if slug contains "night" or slug contains "nt-" -%}{%- assign night = true -%}{%- endif -%}
    {%- assign slug_len = slug | size -%}
    {%- if slug_len == 3 and slug contains "n" -%}{%- assign night = true -%}{%- endif -%}

    {%- comment -%} OpenWeather numeric codes carry no words to match on {%- endcomment -%}
    {%- if slug_len == 3 -%}
      {%- assign code = slug | slice: 0, 2 -%}
      {%- if code == "01" -%}{%- assign slug = "clear" -%}
      {%- elsif code == "02" or code == "03" -%}{%- assign slug = "partly-cloudy" -%}
      {%- elsif code == "04" -%}{%- assign slug = "overcast" -%}
      {%- elsif code == "09" -%}{%- assign slug = "showers" -%}
      {%- elsif code == "10" -%}{%- assign slug = "rain" -%}
      {%- elsif code == "11" -%}{%- assign slug = "thunderstorm" -%}
      {%- elsif code == "13" -%}{%- assign slug = "snow" -%}
      {%- elsif code == "50" -%}{%- assign slug = "fog" -%}
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} most specific first: sleet before rain, thunder before shower {%- endcomment -%}
    {%- if slug contains "thunder" or slug contains "storm" or slug contains "lightning" -%}
      {%- if night -%}{%- assign name = "wi-night-alt-thunderstorm" -%}{%- else -%}{%- assign name = "wi-day-thunderstorm" -%}{%- endif -%}
    {%- elsif slug contains "sleet" or slug contains "freezing" or slug contains "wintry" -%}
      {%- if night -%}{%- assign name = "wi-night-alt-sleet" -%}{%- else -%}{%- assign name = "wi-day-sleet" -%}{%- endif -%}
    {%- elsif slug contains "hail" -%}
      {%- assign name = "wi-hail" -%}
    {%- elsif slug contains "snow" or slug contains "flurr" or slug contains "blizzard" -%}
      {%- if night -%}{%- assign name = "wi-night-alt-snow" -%}{%- else -%}{%- assign name = "wi-day-snow" -%}{%- endif -%}
    {%- elsif slug contains "drizzle" or slug contains "sprinkle" -%}
      {%- if night -%}{%- assign name = "wi-night-alt-sprinkle" -%}{%- else -%}{%- assign name = "wi-day-sprinkle" -%}{%- endif -%}
    {%- elsif slug contains "shower" -%}
      {%- if night -%}{%- assign name = "wi-night-alt-showers" -%}{%- else -%}{%- assign name = "wi-day-showers" -%}{%- endif -%}
    {%- elsif slug contains "rain" -%}
      {%- if night -%}{%- assign name = "wi-night-alt-rain" -%}{%- else -%}{%- assign name = "wi-day-rain" -%}{%- endif -%}
    {%- elsif slug contains "fog" or slug contains "mist" or slug contains "haze" -%}
      {%- assign name = "wi-fog" -%}
    {%- elsif slug contains "wind" or slug contains "breez" -%}
      {%- assign name = "wi-strong-wind" -%}
    {%- elsif slug contains "partly" or slug contains "partial" or slug contains "few" or slug contains "scattered" or slug contains "mostly-clear" -%}
      {%- if night -%}{%- assign name = "wi-night-alt-cloudy" -%}{%- else -%}{%- assign name = "wi-day-cloudy" -%}{%- endif -%}
    {%- elsif slug contains "overcast" or slug contains "cloud" -%}
      {%- assign name = "wi-cloudy" -%}
    {%- elsif slug contains "clear" or slug contains "sunny" or slug contains "sun" or slug contains "fair" -%}
      {%- if night -%}{%- assign name = "wi-night-clear" -%}{%- else -%}{%- assign name = "wi-day-sunny" -%}{%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- if raw == "none" or name == "" -%}{%- assign name = "wi-na" -%}{%- endif -%}
  {%- assign mapped = mapped | append: name | append: "," -%}
{%- endfor -%}
{%- assign mapped = mapped | split: "," -%}

{%- assign has_icon_now = false -%}
{%- if raw_now != "none" -%}{%- assign has_icon_now = true -%}{%- endif -%}
{%- assign has_icon_tmrw = false -%}
{%- if raw_tmrw != "none" -%}{%- assign has_icon_tmrw = true -%}{%- endif -%}
{%- assign icon_now = mapped[0] | prepend: "https://trmnl.com/images/plugins/weather/" | append: ".svg" -%}
{%- assign icon_tmrw = mapped[1] | prepend: "https://trmnl.com/images/plugins/weather/" | append: ".svg" -%}
<style>
  /* the platform wraps this markup in .view > .layout - take the whole screen */
  .layout { display: flex !important; flex-direction: column; height: 100%; }
  .layout > .cw { flex: 1 1 auto; min-height: 0; }

  .cw {
    --ink: var(--black, #000);
    --paper: var(--white, #fff);
    --gut: {{ gut }}px;
    --wx-h: {{ wx_h }}px;
    --head-h: {{ head_h }}px;
    --ad-h: {{ ad_px }}px;
    --sun-h: {{ sun_px }}px;
    {%- if has_sun %}
    /* generated above: the curve, and the same curve pushed down by the line
       width to mask it back to an edge. An empty value would make polygon()
       invalid and paint the whole layer, so the clipped divs are only emitted
       when these are. */
    --sun-shape: {{ sun_shape }};
    --sun-under: {{ sun_under }};
    {%- endif %}
    /* Greys come from the framework so they follow --framework-bit-depth: on a
       2-bit panel these resolve to real grey levels, on 1-bit to dither tiles. */
    --tile-size: var(--dither-bg-size, 16px 16px);
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
    color: var(--ink);
    background: var(--paper);
    image-rendering: pixelated;
  }

  /* ---------------- weather strip ---------------- */
  /* same column track as the grid below, so "now" sits over today's column */
  .cw__wx {
    flex: 0 0 var(--wx-h);
    display: grid;
    grid-template-columns: var(--gut) repeat({{ day_count }}, 1fr);
    border-bottom: 2px solid var(--ink);
    overflow: hidden;
  }
  .cw__wx-cell {
    display: flex;
    flex-direction: column;
    place-content: center;
    overflow: hidden;
    border-left: 1px dashed var(--ink);
  }
  .cw__wx-cell span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cw__wx-row {
    display: flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
    min-height: 32px;   /* keeps both cells' captions on the same line */
  }
  .cw__wx-icon { width: 32px; height: 32px; flex: 0 0 auto; }
  .cw__cap { display: flex; align-items: baseline; gap: 5px; min-width: 0; }
  .cw__lo { font-weight: inherit; }

  /* ---------------- hourly: condition icons over a sunlight curve ----------- */
  /* Three stacked rows on one column track: temperature, then the curve with the
     icons over it, then the times. */
  .cw__hourly {
    display: flex;
    flex-direction: column;
    place-content: center;
    min-width: 0;
    overflow: hidden;
    border-left: 1px dashed var(--ink);
  }
  .cw__hr-row { display: flex; min-width: 0; }
  .cw__hr-row > * {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: center;
    place-content: center;
    overflow: hidden;
    white-space: nowrap;
  }
  .cw__hr-temps, .cw__hr-times { flex: 0 0 auto; }
  /* the now marker, inverted to match today's column heading below. On the inner
     span so the fill hugs the label instead of the whole cell. */
  .cw__hr-now { background: var(--ink); color: var(--paper); }

  .cw__sun { position: relative; flex: 0 0 var(--sun-h); min-width: 0; }
  .cw__sun-line, .cw__sun-mask, .cw__sun-dash {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
  }
  /* The curve is a line, not an area: the ink layer is the whole shape, and the
     mask is the same shape pushed down by the line width and painted in paper on
     top, so all that survives is the edge. Nothing under the curve is shaded, so
     the icons sit on bare paper and there is no tone to read as a quantity. */
  .cw__sun-line { background: var(--ink); clip-path: polygon(var(--sun-shape)); }
  .cw__sun-mask { background: var(--paper); clip-path: polygon(var(--sun-under)); }
  /* Paper stripes over the finished line, which is what breaks it into dashes -
     the clip-path shape itself has no notion of a stroke to dash. Everything
     either side of the line is already paper, so the stripes only show where they
     cross it. Same 5px on, 5px off as the now-line, so the two agree; hard
     colour stops, so there is no gradient for the panel to dither. */
  .cw__sun-dash {
    background-image: repeating-linear-gradient(to right,
      transparent 0 5px, var(--paper) 5px 10px);
  }
  .cw__sun-icons { position: relative; height: 100%; }
  .cw__sun-icon { width: 30px; height: 30px; }

  /* ---------------- calendar ---------------- */
  .cw__cal { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
  .cw__head, .cw__ad, .cw__body {
    display: grid;
    grid-template-columns: var(--gut) repeat({{ day_count }}, 1fr);
  }
  .cw__head { flex: 0 0 var(--head-h); border-bottom: 1px solid var(--ink); }
  .cw__ad   { flex: 0 0 var(--ad-h); border-bottom: 1px solid var(--ink); overflow: hidden; }
  .cw__body { flex: 1 1 auto; min-height: 0; position: relative; }

  /* Headings stay ink-on-paper: a dither behind 12px type breaks up the glyphs,
     so the weekend wash lives on the column and the all-day cell instead. */
  .cw__hcell {
    display: flex;
    align-items: center;
    place-content: center;
    gap: 5px;
    overflow: hidden;
    border-left: 1px dashed var(--ink);
  }
  .cw__hcell--today { background: var(--ink); color: var(--paper); }
  .cw__dow { text-transform: uppercase; }

  .cw__gut { position: relative; overflow: hidden; }
  /* Centred on the hour line, not hanging below it, with a tick running into the
     grid so it is unambiguous which line a label belongs to. */
  .cw__hr {
    position: absolute;
    right: 13px;
    white-space: nowrap;
    transform: translateY(-50%);
  }
  .cw__hr--first { transform: none; }
  .cw__tick {
    position: absolute;
    right: 0;
    width: 9px;
    height: 0;
    border-top: 1px solid var(--ink);
  }
  {%- comment -%} display:flex + centering here comes from the framework's
    own flex/flex--center-y/flex--right utility classes on the elements
    below instead of a custom rule -- safe because both only ever wrap a
    single child, so .flex's own default gap has nothing to apply between.
  {%- endcomment -%}
  .cw__ad-gut span, .cw__gut-head span { white-space: nowrap; }

  .cw__col {
    position: relative;
    overflow: hidden;
    border-left: 1px dashed var(--ink);
    background-image: linear-gradient(to bottom, var(--ink) 0, var(--ink) 1px, transparent 1px);
    background-size: 100% calc(100% / {{ hours }});
  }
  .cw__col--we {
    background: var(--bg-gray-70-color, #fff);
    background-image:
      linear-gradient(to bottom, var(--ink) 0, var(--ink) 1px, transparent 1px),
      var(--bg-gray-70-image, none);
    background-size: 100% calc(100% / {{ hours }}), var(--tile-size);
  }
  .cw__adcol {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1px;
    overflow: hidden;
    border-left: 1px dashed var(--ink);
  }
  .cw__adcol--we {
    background: var(--bg-gray-70-color, #fff);
    background-image: var(--bg-gray-70-image, none);
    background-size: var(--tile-size);
  }

  /* ---------------- event blocks ----------------
     Three widths. A block narrower than ~44px cannot hold a legible word, so it
     drops the title and becomes a solid marker rather than printing "Regi da...".
     min-height clears the border box of a 12px line so short events are not
     shaved off at the baseline. */
  .cw__ev {
    position: absolute;
    box-sizing: border-box;
    min-height: 16px;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--ink);
  }
  .cw__ev--sliver { min-height: 6px; }
  .cw__ev--live { background: var(--ink); color: var(--paper); }
  .cw__ev--off { border-style: dashed; }

  /* one grey per calendar colour, as a dithered edge bar */
  .cw__edge {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background: var(--ink);
    background-size: var(--tile-size);
  }
  .cw__ev--narrow .cw__edge { width: 3px; }
  .cw__ev--sliver .cw__edge { width: 100%; }
  .cw__edge--t1 { background: var(--bg-gray-20-color, #555); background-image: var(--bg-gray-20-image, none); }
  .cw__edge--t2 { background: var(--bg-gray-40-color, #aaa); background-image: var(--bg-gray-40-image, none); }
  .cw__edge--t3 { background: var(--bg-gray-60-color, #ddd); background-image: var(--bg-gray-60-image, none); }
  .cw__ev--live .cw__edge { background: var(--paper); background-image: none; }
  /* a sliver is all edge bar - whitening it would invert the block, not mark it */
  .cw__ev--sliver.cw__ev--live .cw__edge { display: none; }
  /* pin the leading so a label is exactly its font size tall - that is what
     lets a 30-minute block carry one line without shaving the descenders */
  .cw .cw__ev .cw__ev-txt,
  .cw .cw__ev .cw__ev-where { line-height: 1; }
  .cw__ev-txt { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .cw__ev-txt--clamp {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    white-space: normal;
    text-overflow: clip;
  }
  .cw__ev-where { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Outlined, not inverted: inversion is reserved for today and in-progress, and
     paper-on-ink at 12px is the weakest thing an eInk panel can render. */
  .cw__chip {
    display: block;
    height: 18px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    background: var(--paper);
    border: 1px solid var(--ink);
  }
  .cw__more { display: block; height: 18px; white-space: nowrap; }

  /* Dashed ink-on-paper, so it stays visible over an in-progress block, which is
     filled with ink - a solid ink line simply vanished there. */
  .cw__now {
    position: absolute;
    left: -1px;
    right: 0;
    height: 2px;
    background-image: repeating-linear-gradient(to right,
      var(--ink) 0 5px, var(--paper) 5px 10px);
  }
  .cw__now::before {
    content: "";
    position: absolute;
    top: -3px;
    left: 0;
    width: 8px;
    height: 8px;
    background: var(--ink);
    outline: 1px solid var(--paper);
  }

  /* counts for what is not drawn: above the window, below it, or too deeply
     stacked to fit a lane. Inverted so they read as a badge over a block. */
  .cw__badge {
    position: absolute;
    right: 0;
    background: var(--ink);
    color: var(--paper);
    outline: 1px solid var(--paper);
  }
  .cw__badge--post { bottom: 0; }
  .cw__hcell-badge { border: 1px solid currentColor; }

  {%- comment -%} display:flex + centering comes from the framework's own
    flex/flex--center utility classes on the element below -- safe because
    it only ever wraps a single child. Positioning stays custom CSS: no
    framework utility covers absolute inset positioning. {%- endcomment -%}
  .cw__empty {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
  }
  .cw__empty span { background: var(--paper); border: 1px solid var(--ink); }
  .cw__setup { display: flex; flex-direction: column; gap: 8px; }
</style>
<div class="cw">

  {%- comment -%} ============ weather strip ============ {%- endcomment -%}
  <div class="cw__wx">
    {%- if wx or temp_now -%}
      <div class="cw__wx-cell px--1" style="grid-column:{{ c_now }}">
        <div class="cw__wx-row">
          {%- if has_icon_now -%}
            <img class="cw__wx-icon image image--adaptive" src="{{ icon_now }}" alt="" />
          {%- endif -%}
          <span class="text--large">{{ temp_now | round }}&deg;</span>
        </div>
        {%- if wx_cond and wx_cond != "" -%}
          <span class="text--small">{{ wx_cond }}</span>
        {%- endif -%}
      </div>

      {%- assign fc_tmrw = wx.forecast.tomorrow -%}
      {%- if fc_tmrw and c_tmrw <= last_col -%}
        <div class="cw__wx-cell px--1" style="grid-column:{{ c_tmrw }}">
          <div class="cw__wx-row">
            {%- if has_icon_tmrw -%}
              <img class="cw__wx-icon image image--adaptive" src="{{ icon_tmrw }}" alt="" />
            {%- endif -%}
            <span class="text--large">{{ fc_tmrw.maxtemp | round }}&deg;</span>
          </div>
          <span class="cw__cap text--small">{% if fc_tmrw.day_override and fc_tmrw.day_override != "" %}{{ fc_tmrw.day_override }}{% else %}Tomorrow{% endif %}<b class="cw__lo">{{ fc_tmrw.mintemp | round }}&deg;</b></span>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="cw__wx-cell px--1" style="grid-column:{{ c_now }}">
        <span class="text--small">No weather source selected</span>
      </div>
    {%- endif -%}

    {%- if has_hourly == false and hourly_source and c_graph <= last_col -%}
      {%- comment -%} selected but unusable - say so rather than just dropping the panel {%- endcomment -%}
      <div class="cw__wx-cell px--1" style="grid-column:{{ c_graph }} / -1">
        <span class="text--small">Hourly source has no "temperatures" - check the recipe</span>
      </div>
    {%- endif -%}

    {%- if has_hourly -%}
      {%- comment -%} Temperature is a number, not a bar height: at this size the
        figure is what gets read, and the panel's one graphed quantity is the
        daylight behind the icons. {%- endcomment -%}
      <div class="cw__hourly px--2" style="grid-column:{{ c_graph }} / -1">
        <div class="cw__hr-row cw__hr-temps">
          {%- for t in temps -%}
            {%- assign v = t | first -%}
            {%- unless v -%}{%- assign v = t -%}{%- endunless -%}
            <span class="text--base">{{ v | round }}&deg;</span>
          {%- endfor -%}
        </div>
        <div class="cw__sun">
          {%- if has_sun -%}
            <div class="cw__sun-line"></div>
            <div class="cw__sun-mask"></div>
            <div class="cw__sun-dash"></div>
          {%- endif -%}
          <div class="cw__hr-row cw__sun-icons">
            {%- for t in temps -%}
              {%- assign ic = hourly.weather_icons[forloop.index0] -%}
              <span>
                {%- if ic and ic != "" -%}
                  <img class="cw__sun-icon image image--adaptive" src="{{ ic }}" alt="" />
                {%- endif -%}
              </span>
            {%- endfor -%}
          </div>
        </div>
        <div class="cw__hr-row cw__hr-times">
          {%- for t in temps -%}
            {%- assign lbl = hourly.timestamps_formatted[forloop.index0] -%}
            <span class="text--small">
              {%- if forloop.index0 == near_i -%}
                <span class="cw__hr-now px--1">{{ lbl }}</span>
              {%- else -%}
                {{- lbl -}}
              {%- endif -%}
            </span>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} test the data, not the field: an unselected field can be an
    empty string, which Liquid counts as truthy {%- endcomment -%}
  {%- unless cal.events -%}
    {%- comment -%} ============ first-run help ============ {%- endcomment -%}
    <div class="cw__cal">
      <div class="cw__setup p--6">
        <p class="m--0 text--base">No calendar source selected.</p>
        <p class="m--0 text--small">Open this plugin's settings and choose your calendar, weather and
          (optionally) hourly weather instances, or edit the fallback merge variables at the top
          of the markup - their names are in the Merge Variables dropdown.</p>
        <p class="m--0 text--small">Both source plugins must sit on a playlist - hidden is fine - or their data never refreshes.</p>
      </div>
    </div>
  {%- else -%}

  {%- comment -%} ============ calendar ============ {%- endcomment -%}
  <div class="cw__cal">

    {%- comment -%} ---- day headings ---- {%- endcomment -%}
    <div class="cw__head">
      <div class="cw__gut-head pr--2 flex flex--center-y flex--right"><span class="text--small">{{ base_noon | date: "%b" | upcase }}</span></div>
      {%- for n in (1..day_count) -%}
        {%- assign off = n | minus: 1 | times: 86400 -%}
        {%- assign day_noon = base_noon | plus: off -%}
        {%- assign day_key = day_noon | date: "%Y-%m-%d" -%}
        {%- comment -%} events outside the visible hours are counted here rather
          than in the column, where the badge would sit on top of a block {%- endcomment -%}
        {%- assign out_n = 0 -%}
        {%- for e in events -%}
          {%- unless e.all_day -%}
            {%- assign esd = e.start_full | date: "%Y-%m-%d" -%}
            {%- if esd == day_key -%}
              {%- assign osmin = e.start_full | date: "%H" | plus: 0 | times: 60 -%}
              {%- assign osm = e.start_full | date: "%M" | plus: 0 -%}
              {%- assign osmin = osmin | plus: osm -%}
              {%- assign oemin = e.end_full | date: "%H" | plus: 0 | times: 60 -%}
              {%- assign oem = e.end_full | date: "%M" | plus: 0 -%}
              {%- assign oemin = oemin | plus: oem -%}
              {%- assign oed = e.end_full | date: "%Y-%m-%d" -%}
              {%- if oed != esd -%}{%- assign oemin = 1440 -%}{%- endif -%}
              {%- if oemin <= osmin -%}{%- assign oemin = osmin | plus: 30 -%}{%- endif -%}
              {%- if oemin <= win_start or osmin >= win_end -%}{%- assign out_n = out_n | plus: 1 -%}{%- endif -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
        <div class="cw__hcell{% if day_key == today and highlight_today %} cw__hcell--today{% endif %}">
          <span class="cw__dow text--small">{{ day_noon | date: "%a" }}</span>
          <span class="text--base">{{ day_noon | date: "%d" | plus: 0 }}</span>
          {%- if out_n > 0 -%}<span class="cw__hcell-badge px--1 text--small">+{{ out_n }}</span>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} ---- all-day band ---- {%- endcomment -%}
    {%- if ad_rows > 0 -%}
      <div class="cw__ad">
        <div class="cw__ad-gut pr--2 flex flex--center-y flex--right"><span class="text--small">ALL</span></div>
        {%- for n in (1..day_count) -%}
          {%- assign off = n | minus: 1 | times: 86400 -%}
          {%- assign day_noon = base_noon | plus: off -%}
          {%- assign dow = day_noon | date: "%w" | plus: 0 -%}
          {%- assign weekend = false -%}
          {%- if dow == 0 or dow == 6 -%}
            {%- if shade_weekends -%}{%- assign weekend = true -%}{%- endif -%}
          {%- endif -%}
          <div class="cw__adcol{% if weekend %} cw__adcol--we{% endif %}">
            {%- comment -%} count first, so the last row can become "+N more" {%- endcomment -%}
            {%- assign ad_n = 0 -%}
            {%- for e in events -%}
              {%- if e.all_day -%}
                {%- assign s_ep = e.start_full | date: "%Y-%m-%d" | date: "%s" | plus: 0 -%}
                {%- assign x_ep = e.end_full | date: "%Y-%m-%d" | date: "%s" | plus: 0 -%}
                {%- if x_ep <= s_ep -%}{%- assign x_ep = s_ep | plus: 86400 -%}{%- endif -%}
                {%- if day_noon > s_ep and day_noon < x_ep -%}{%- assign ad_n = ad_n | plus: 1 -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- assign cap = ad_rows -%}
            {%- if ad_n > ad_rows -%}{%- assign cap = ad_rows | minus: 1 -%}{%- endif -%}
            {%- assign shown = 0 -%}
            {%- for e in events -%}
              {%- if e.all_day -%}
                {%- assign s_ep = e.start_full | date: "%Y-%m-%d" | date: "%s" | plus: 0 -%}
                {%- assign x_ep = e.end_full | date: "%Y-%m-%d" | date: "%s" | plus: 0 -%}
                {%- if x_ep <= s_ep -%}{%- assign x_ep = s_ep | plus: 86400 -%}{%- endif -%}
                {%- if day_noon > s_ep and day_noon < x_ep and shown < cap -%}
                  <span class="cw__chip px--1 text--small">{{ e.summary }}</span>
                  {%- assign shown = shown | plus: 1 -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- assign hidden = ad_n | minus: shown -%}
            {%- if hidden > 0 -%}<span class="cw__more px--1 text--small">+{{ hidden }} more</span>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---- time grid ---- {%- endcomment -%}
    <div class="cw__body">

      <div class="cw__gut">
        {%- for n in (1..hours) -%}
          {%- assign hh = h_from | plus: n | minus: 1 -%}
          {%- assign top = n | minus: 1 | times: 100.0 | divided_by: hours -%}
          <i class="cw__tick" style="top:{{ top | round: 3 }}%"></i>
          <span class="cw__hr{% if forloop.first %} cw__hr--first{% endif %} text--base" style="top:{{ top | round: 3 }}%">
            {%- if is_24h -%}
              {{ hh | prepend: "0" | slice: -2, 2 }}
            {%- else -%}
              {%- assign h12 = hh | modulo: 12 -%}
              {%- if h12 == 0 -%}{%- assign h12 = 12 -%}{%- endif -%}
              {{ h12 }} {% if hh < 12 %}AM{% else %}PM{% endif %}
            {%- endif -%}
          </span>
        {%- endfor -%}
      </div>

      {%- for n in (1..day_count) -%}
        {%- assign off = n | minus: 1 | times: 86400 -%}
        {%- assign day_noon = base_noon | plus: off -%}
        {%- assign day_key = day_noon | date: "%Y-%m-%d" -%}
        {%- assign dow = day_noon | date: "%w" | plus: 0 -%}
        {%- assign weekend = false -%}
        {%- if dow == 0 or dow == 6 -%}
          {%- if shade_weekends -%}{%- assign weekend = true -%}{%- endif -%}
        {%- endif -%}

        <div class="cw__col{% if weekend %} cw__col--we{% endif %}">
          {%- comment -%}
            Google-Calendar-style lanes: greedy left to right, each block only as
            narrow as the events it actually collides with. l0/l1/l2 hold the end
            minute of the event currently occupying each lane. Events wholly
            outside the visible window are counted, not drawn - clamping them to
            the edge used to pile them up on the first row.
          {%- endcomment -%}
          {%- assign l0 = -1 -%}{%- assign l1 = -1 -%}{%- assign l2 = -1 -%}
          {%- assign spill = 0 -%}
          {%- for e in events -%}
            {%- unless e.all_day -%}
              {%- assign sd = e.start_full | date: "%Y-%m-%d" -%}
              {%- if sd == day_key -%}
                {%- assign smin = e.start_full | date: "%H" | plus: 0 | times: 60 -%}
                {%- assign sm = e.start_full | date: "%M" | plus: 0 -%}
                {%- assign smin = smin | plus: sm -%}
                {%- assign emin = e.end_full | date: "%H" | plus: 0 | times: 60 -%}
                {%- assign em = e.end_full | date: "%M" | plus: 0 -%}
                {%- assign emin = emin | plus: em -%}
                {%- assign ed = e.end_full | date: "%Y-%m-%d" -%}
                {%- if ed != sd -%}{%- assign emin = 1440 -%}{%- endif -%}
                {%- if emin <= smin -%}{%- assign emin = smin | plus: 30 -%}{%- endif -%}

                {%- if emin <= win_start or smin >= win_end -%}
                  {%- comment -%} outside the window: counted in the day heading {%- endcomment -%}
                {%- else -%}

                {%- assign lane = -1 -%}
                {%- if smin >= l0 -%}
                  {%- assign lane = 0 -%}{%- assign l0 = emin -%}
                {%- elsif smin >= l1 -%}
                  {%- assign lane = 1 -%}{%- assign l1 = emin -%}
                {%- elsif smin >= l2 -%}
                  {%- assign lane = 2 -%}{%- assign l2 = emin -%}
                {%- else -%}
                  {%- comment -%} four deep: count it rather than draw over another block {%- endcomment -%}
                  {%- assign spill = spill | plus: 1 -%}
                {%- endif -%}

                {%- if lane >= 0 -%}
                  {%- comment -%} how many visible events share this slot? that sets the width {%- endcomment -%}
                  {%- assign ovl = 0 -%}
                  {%- for o in events -%}
                    {%- unless o.all_day -%}
                      {%- assign osd = o.start_full | date: "%Y-%m-%d" -%}
                      {%- if osd == day_key -%}
                        {%- assign osmin = o.start_full | date: "%H" | plus: 0 | times: 60 -%}
                        {%- assign osm = o.start_full | date: "%M" | plus: 0 -%}
                        {%- assign osmin = osmin | plus: osm -%}
                        {%- assign oemin = o.end_full | date: "%H" | plus: 0 | times: 60 -%}
                        {%- assign oem = o.end_full | date: "%M" | plus: 0 -%}
                        {%- assign oemin = oemin | plus: oem -%}
                        {%- assign oed = o.end_full | date: "%Y-%m-%d" -%}
                        {%- if oed != osd -%}{%- assign oemin = 1440 -%}{%- endif -%}
                        {%- if oemin <= osmin -%}{%- assign oemin = osmin | plus: 30 -%}{%- endif -%}
                        {%- if oemin > win_start and osmin < win_end -%}
                          {%- if osmin < emin and oemin > smin -%}{%- assign ovl = ovl | plus: 1 -%}{%- endif -%}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endunless -%}
                  {%- endfor -%}
                  {%- if ovl < 1 -%}{%- assign ovl = 1 -%}{%- endif -%}
                  {%- if ovl > 3 -%}{%- assign ovl = 3 -%}{%- endif -%}
                  {%- if lane >= ovl -%}{%- assign lane = ovl | minus: 1 -%}{%- endif -%}
                  {%- assign lane_w = 100.0 | divided_by: ovl -%}
                  {%- assign lane_px = col_w | divided_by: ovl -%}

                  {%- comment -%} clamp into the visible window {%- endcomment -%}
                  {%- assign vs = smin -%}
                  {%- if vs < win_start -%}{%- assign vs = win_start -%}{%- endif -%}
                  {%- assign ve = emin -%}
                  {%- if ve > win_end -%}{%- assign ve = win_end -%}{%- endif -%}
                  {%- assign dur = ve | minus: vs -%}

                  {%- assign top = vs | minus: win_start | times: 100.0 | divided_by: win_span -%}
                  {%- assign hgt = dur | times: 100.0 | divided_by: win_span -%}
                  {%- assign left = lane | times: lane_w -%}
                  {%- assign px = dur | times: px_per_min -%}

                  {%- comment -%} grey tone for this event's calendar colour {%- endcomment -%}
                  {%- assign tone = 0 -%}
                  {%- if colorize and e.background_color -%}
                    {%- for c in palette -%}
                      {%- if c == e.background_color -%}
                        {%- assign tone = forloop.index0 | modulo: 4 -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}

                  {%- assign live = false -%}
                  {%- if day_key == today and now_min >= smin and now_min < emin -%}{%- assign live = true -%}{%- endif -%}

                  {%- assign off_event = false -%}
                  {%- if e.summary contains "Cancel" -%}{%- assign off_event = true -%}{%- endif -%}

                  {%- comment -%} width decides how much of a title is worth printing {%- endcomment -%}
                  {%- assign fit = "wide" -%}
                  {%- assign pad = "pl--2 pr--1" -%}
                  {%- if lane_px < 44 -%}
                    {%- assign fit = "sliver" -%}
                    {%- assign pad = "" -%}
                  {%- elsif lane_px < 70 -%}
                    {%- assign fit = "narrow" -%}
                    {%- assign pad = "pl--1" -%}
                  {%- endif -%}

                  <div class="cw__ev cw__ev--{{ fit }} {{ pad }}{% if live %} cw__ev--live{% endif %}{% if off_event %} cw__ev--off{% endif %}"
                       style="top:{{ top | round: 3 }}%;height:{{ hgt | round: 3 }}%;left:{{ left | round: 3 }}%;width:{{ lane_w | round: 3 }}%">
                    <i class="cw__edge{% if tone > 0 %} cw__edge--t{{ tone }}{% endif %}"></i>
                    {%- comment -%} no time inside the block - the hour gutter carries it {%- endcomment -%}
                    {%- unless fit == "sliver" -%}
                      {%- assign where = "" -%}
                      {%- if fit == "wide" and px >= 30 and ovl == 1 and e.location and e.location != "" -%}
                        {%- unless e.location contains "Teams" or e.location contains "Zoom" or e.location contains "http" -%}
                          {%- assign where = e.location | split: "," | first -%}
                        {%- endunless -%}
                      {%- endif -%}
                      {%- comment -%}
                        One size for every event label: 12px. The framework's
                        pixel fonts only come at 12/16/21, so this is one step
                        down from 16 - it buys roughly twice the characters per
                        line, which is what narrow and overlapping blocks need.
                      {%- endcomment -%}
                      {%- assign clamp = false -%}
                      {%- if where == "" and px >= 28 -%}{%- assign clamp = true -%}{%- endif -%}
                      <span class="cw__ev-txt{% if clamp %} cw__ev-txt--clamp{% endif %} text--small">{{ e.summary }}</span>
                      {%- if where != "" -%}
                        <span class="cw__ev-where text--small">{{ where }}</span>
                      {%- endif -%}
                    {%- endunless -%}
                  </div>
                {%- endif -%}

                {%- endif -%}
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}

          {%- if spill > 0 -%}
            <span class="cw__badge cw__badge--post px--1 text--small">+{{ spill }}</span>
          {%- endif -%}

          {%- if show_now and day_key == today and now_min >= win_start and now_min <= win_end -%}
            {%- assign now_top = now_min | minus: win_start | times: 100.0 | divided_by: win_span -%}
            <div class="cw__now" style="top:{{ now_top | round: 3 }}%"></div>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- if events == empty -%}
        <div class="cw__empty flex flex--center"><span class="py--1 px--3 text--base">Nothing scheduled</span></div>
      {%- endif -%}
    </div>
  </div>
  {%- endunless -%}
</div>
