{%- comment -%}
  WEEK + WEATHER - half horizontal. A time grid is unreadable at 800x240, so
  this layout shows three day columns as compact agendas, under one weather line.
{%- endcomment -%}

{%- assign cal = calendar_source -%}
{%- unless cal -%}{%- assign cal = google_calendar_12345 -%}{%- endunless -%}
{%- assign wx = weather_source -%}
{%- unless wx -%}{%- assign wx = weather_67890 -%}{%- endunless -%}

{%- assign events = cal.events | sort: "start_full" -%}

{%- comment -%} the calendar's own offset beats trmnl.user.utc_offset, which is 0
  for accounts with no time zone set {%- endcomment -%}
{%- assign tz_off = 0 -%}
{%- if trmnl.user.utc_offset -%}{%- assign tz_off = trmnl.user.utc_offset | plus: 0 -%}{%- endif -%}
{%- if cal.today_in_tz -%}
  {%- assign z = cal.today_in_tz | date: "%z" -%}
  {%- assign z_h = z | slice: 1, 2 | plus: 0 -%}
  {%- assign z_m = z | slice: 3, 2 | plus: 0 -%}
  {%- assign z_s = z_h | times: 3600 -%}
  {%- assign z_s = z_m | times: 60 | plus: z_s -%}
  {%- if z contains "-" -%}{%- assign z_s = 0 | minus: z_s -%}{%- endif -%}
  {%- assign tz_off = z_s -%}
{%- endif -%}
{%- assign now_utc = "now" | date: "%s" | plus: 0 -%}
{%- if trmnl.system.timestamp_utc -%}{%- assign now_utc = trmnl.system.timestamp_utc | plus: 0 -%}{%- endif -%}
{%- assign now_local = now_utc | plus: tz_off -%}
{%- assign today = now_local | date: "%Y-%m-%d" -%}
{%- if cal.today_in_tz -%}{%- assign today = cal.today_in_tz | date: "%Y-%m-%d" -%}{%- endif -%}

{%- comment -%} weather keys vary by provider (Tempest omits the top-level conditions) {%- endcomment -%}
{%- assign wx_temp = wx.temperature -%}
{%- unless wx_temp -%}{%- assign wx_temp = wx.forecast.right_now.temperature -%}{%- endunless -%}
{%- assign wx_cond = wx.conditions -%}
{%- unless wx_cond -%}{%- assign wx_cond = wx.right_now_conditions -%}{%- endunless -%}
{%- unless wx_cond -%}{%- assign wx_cond = wx.forecast.right_now.conditions -%}{%- endunless -%}

{%- assign base_noon = today | date: "%s" | plus: 43200 -%}

<style>
  .view, .layout { padding: 0 !important; }
  .layout { display: flex !important; flex-direction: column; height: 100%; }
  .layout > .cwm { flex: 1 1 auto; min-height: 0; }

  .cwm {
    --ink: var(--black, #000);
    --paper: var(--white, #fff);
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    color: var(--ink);
    background: var(--paper);
  }
  .cwm__wx {
    flex: 0 0 30px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 8px;
    border-bottom: 2px solid var(--ink);
    overflow: hidden;
  }
  .cwm__wx img { width: 22px; height: 22px; }
  .cwm__wx span { white-space: nowrap; }
  .cwm__pad { flex: 1 1 auto; }

  .cwm__days { flex: 1 1 auto; min-height: 0; display: grid; grid-template-columns: repeat(3, 1fr); }
  .cwm__day { min-height: 0; overflow: hidden; padding: 2px 6px; border-left: 1px dashed var(--ink); }
  .cwm__day:first-child { border-left: 0; }
  .cwm__dh { display: block; margin-bottom: 2px; border-bottom: 1px solid var(--ink); }
  .cwm__dh--today { background: var(--ink); color: var(--paper); }
  .cwm__row { display: flex; gap: 5px; overflow: hidden; }
  .cwm__t { flex: 0 0 56px; white-space: nowrap; }
  .cwm__s { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .cwm__allday .cwm__s { background: var(--ink); color: var(--paper); padding: 0 3px; }
</style>

<div class="cwm">
  <div class="cwm__wx">
    <span class="text--base">{{ base_noon | date: "%a" }} {{ base_noon | date: "%d" | plus: 0 }} {{ base_noon | date: "%b" }}</span>
    {%- if wx -%}
      {%- comment -%} providers disagree on icon names and some serve colour SVGs,
        which all but vanish at 2-bit; reduce whatever arrives to TRMNL's mono
        wi-* set (same mapping as full.liquid) {%- endcomment -%}
      {%- assign raw = wx.weather_image -%}
      {%- unless raw and raw != "" -%}{%- assign raw = "none" -%}{%- endunless -%}
      {%- assign slug = raw | split: "/" | last | split: "." | first | downcase -%}
      {%- assign name = "" -%}
      {%- if slug contains "wi-" -%}
        {%- assign name = slug -%}
      {%- else -%}
        {%- assign night = false -%}
        {%- if slug contains "night" or slug contains "nt-" -%}{%- assign night = true -%}{%- endif -%}
        {%- assign slug_len = slug | size -%}
        {%- if slug_len == 3 and slug contains "n" -%}{%- assign night = true -%}{%- endif -%}
        {%- if slug_len == 3 -%}
          {%- assign code = slug | slice: 0, 2 -%}
          {%- if code == "01" -%}{%- assign slug = "clear" -%}
          {%- elsif code == "02" or code == "03" -%}{%- assign slug = "partly-cloudy" -%}
          {%- elsif code == "04" -%}{%- assign slug = "overcast" -%}
          {%- elsif code == "09" -%}{%- assign slug = "showers" -%}
          {%- elsif code == "10" -%}{%- assign slug = "rain" -%}
          {%- elsif code == "11" -%}{%- assign slug = "thunderstorm" -%}
          {%- elsif code == "13" -%}{%- assign slug = "snow" -%}
          {%- elsif code == "50" -%}{%- assign slug = "fog" -%}
          {%- endif -%}
        {%- endif -%}
        {%- if slug contains "thunder" or slug contains "storm" or slug contains "lightning" -%}
          {%- if night -%}{%- assign name = "wi-night-alt-thunderstorm" -%}{%- else -%}{%- assign name = "wi-day-thunderstorm" -%}{%- endif -%}
        {%- elsif slug contains "sleet" or slug contains "freezing" or slug contains "wintry" -%}
          {%- if night -%}{%- assign name = "wi-night-alt-sleet" -%}{%- else -%}{%- assign name = "wi-day-sleet" -%}{%- endif -%}
        {%- elsif slug contains "hail" -%}
          {%- assign name = "wi-hail" -%}
        {%- elsif slug contains "snow" or slug contains "flurr" or slug contains "blizzard" -%}
          {%- if night -%}{%- assign name = "wi-night-alt-snow" -%}{%- else -%}{%- assign name = "wi-day-snow" -%}{%- endif -%}
        {%- elsif slug contains "drizzle" or slug contains "sprinkle" -%}
          {%- if night -%}{%- assign name = "wi-night-alt-sprinkle" -%}{%- else -%}{%- assign name = "wi-day-sprinkle" -%}{%- endif -%}
        {%- elsif slug contains "shower" -%}
          {%- if night -%}{%- assign name = "wi-night-alt-showers" -%}{%- else -%}{%- assign name = "wi-day-showers" -%}{%- endif -%}
        {%- elsif slug contains "rain" -%}
          {%- if night -%}{%- assign name = "wi-night-alt-rain" -%}{%- else -%}{%- assign name = "wi-day-rain" -%}{%- endif -%}
        {%- elsif slug contains "fog" or slug contains "mist" or slug contains "haze" -%}
          {%- assign name = "wi-fog" -%}
        {%- elsif slug contains "wind" or slug contains "breez" -%}
          {%- assign name = "wi-strong-wind" -%}
        {%- elsif slug contains "partly" or slug contains "partial" or slug contains "few" or slug contains "scattered" or slug contains "mostly-clear" -%}
          {%- if night -%}{%- assign name = "wi-night-alt-cloudy" -%}{%- else -%}{%- assign name = "wi-day-cloudy" -%}{%- endif -%}
        {%- elsif slug contains "overcast" or slug contains "cloud" -%}
          {%- assign name = "wi-cloudy" -%}
        {%- elsif slug contains "clear" or slug contains "sunny" or slug contains "sun" or slug contains "fair" -%}
          {%- if night -%}{%- assign name = "wi-night-clear" -%}{%- else -%}{%- assign name = "wi-day-sunny" -%}{%- endif -%}
        {%- endif -%}
      {%- endif -%}
      {%- if name == "" -%}{%- assign name = "wi-na" -%}{%- endif -%}
      {%- assign icon_now = name | prepend: "https://trmnl.com/images/plugins/weather/" | append: ".svg" -%}
      <img class="image image--adaptive" src="{{ icon_now }}" alt="" />
      <span class="text--base">{{ wx_temp | round }}&deg;</span>
      <span class="text--small">{{ wx_cond }}</span>
      <div class="cwm__pad"></div>
      <span class="text--small">{{ wx.forecast.today.maxtemp | round }}&deg; / {{ wx.forecast.today.mintemp | round }}&deg; today</span>
    {%- else -%}
      <div class="cwm__pad"></div>
      <span class="text--small">No weather source selected</span>
    {%- endif -%}
  </div>

  <div class="cwm__days">
    {%- for n in (1..3) -%}
      {%- assign off = n | minus: 1 | times: 86400 -%}
      {%- assign day_noon = base_noon | plus: off -%}
      {%- assign day_key = day_noon | date: "%Y-%m-%d" -%}
      <div class="cwm__day">
        <span class="cwm__dh text--small{% if day_key == today %} cwm__dh--today{% endif %}">{{ day_noon | date: "%a" }} {{ day_noon | date: "%d" | plus: 0 }} {{ day_noon | date: "%b" }}</span>
        {%- assign shown = 0 -%}
        {%- assign hidden = 0 -%}
        {%- for e in events -%}
          {%- if e.all_day -%}
            {%- assign s_ep = e.start_full | date: "%Y-%m-%d" | date: "%s" | plus: 0 -%}
            {%- assign x_ep = e.end_full | date: "%Y-%m-%d" | date: "%s" | plus: 0 -%}
            {%- if x_ep <= s_ep -%}{%- assign x_ep = s_ep | plus: 86400 -%}{%- endif -%}
            {%- assign hit = false -%}
            {%- if day_noon > s_ep and day_noon < x_ep -%}{%- assign hit = true -%}{%- endif -%}
          {%- else -%}
            {%- assign sd = e.start_full | date: "%Y-%m-%d" -%}
            {%- assign hit = false -%}
            {%- if sd == day_key -%}{%- assign hit = true -%}{%- endif -%}
          {%- endif -%}
          {%- if hit -%}
            {%- if shown < 11 -%}
              <div class="cwm__row{% if e.all_day %} cwm__allday{% endif %}">
                {%- unless e.all_day -%}
                  <span class="cwm__t text--small">{% if e.start and e.start != "" %}{{ e.start }}{% else %}{{ e.start_full | date: "%H:%M" }}{% endif %}</span>
                {%- endunless -%}
                <span class="cwm__s text--small">{{ e.summary }}</span>
              </div>
              {%- assign shown = shown | plus: 1 -%}
            {%- else -%}
              {%- assign hidden = hidden | plus: 1 -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if hidden > 0 -%}<span class="text--small">+{{ hidden }} more</span>{%- endif -%}
        {%- if shown == 0 -%}<span class="text--small">Clear</span>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>
